      "description": "Standard olive action; submit uses a larger variant.",
      "html": "<button class=\"ds-primary\">开始练习</button>",
      "css": ".ds-primary{font-family:'Noto Serif SC',serif;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;background:#526d3b;color:#fffbea;border:1px solid #ffffffe0;box-shadow:inset 0 2px 5px #fffffe60,inset 0 -2px 5px #b1c08480,0 4px 11px #4e623535;min-height:48px;padding:10px 30px;border-radius:28px;font-size:18px;transition:background .2s,box-shadow .2s}.ds-primary:hover{background:#425f2c;box-shadow:inset 0 2px 5px #fffffe70,0 6px 16px #4e62354d}.ds-primary:focus-visible{outline:3px solid #6f8952;outline-offset:4px}.ds-primary:disabled{cursor:default;opacity:.35}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
    },
    {
      "name": "Page action",
      "kind": "button",
      "refersTo": "button-page",
      "description": "Quiet question paging action.",
      "html": "<button class=\"ds-page\"><svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>下一题</button>",
      "css": ".ds-page{font-family:'Noto Serif SC',serif;display:flex;align-items:center;gap:14px;background:none;border:0;color:var(--green,#425a31);font-size:20px;padding:10px 4px;cursor:pointer}.ds-page:hover:not(:disabled){color:#1e3913}.ds-page:focus-visible{outline:3px solid #6f8952;outline-offset:4px}.ds-page:disabled{opacity:.35;cursor:default}"
    },
    {
      "name": "Glass navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Horizontal links in a highlighted glass capsule.",
      "html": "<nav class=\"ds-nav\" aria-label=\"学习导航\"><button class=\"ds-link ds-selected\" aria-current=\"page\">章节练习</button><button class=\"ds-link\">错题重做</button><button class=\"ds-link\">我的笔记</button></nav>",
      "css": ".ds-nav{background:rgba(255,253,242,.35);border:1px solid #ffffffe6;box-shadow:inset 0 2px 3px #ffffffec,inset 0 -2px 5px #fff9,0 8px 24px -16px #6e532b80;backdrop-filter:blur(24px) saturate(130%);display:flex;align-items:center;gap:26px;padding:0 28px;min-height:76px;border-radius:42px;flex-wrap:wrap}.ds-link{font-family:'Noto Serif SC',serif;font-size:20px;padding:12px 26px;border:0;background:none;color:var(--ink,#3e352a);border-radius:28px;cursor:pointer;transition:background .2s,box-shadow .2s}.ds-selected{background:#f1f2dc80;box-shadow:inset 0 2px 3px #ffffffe6,inset 0 -1px 3px #fff,0 4px 9px #676d3e26;color:var(--green,#425a31)}.ds-link:hover{background:#fffffe70}.ds-link:focus-visible{outline:3px solid #6f8952;outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-link{transition:none}}"
