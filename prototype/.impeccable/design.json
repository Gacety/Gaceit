  "narrative": {
    "northStar": "Warm liquid-glass workbook",
    "overview": "Warm liquid glass frames a quiet ivory workbook. The selected apricot and sage optical backdrop supplies atmosphere; near-opaque reading surfaces keep Chinese questions, scratch work, and notes legible. This records the shipped implementation, following the selected source rather than proposing a new visual direction.",
    "keyCharacteristics": [
      "Apricot and sage optical backdrop with restrained glass framing.",
      "Chinese serif reading hierarchy and olive actions.",
      "A single workbook with question above, scratchpaper left, and notes right."
    ],
    "rules": [
      {
        "name": "The Paper Rule",
        "body": "Keep the workbook near-opaque; reserve optical transparency for framing and controls.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do preserve the selected warm backdrop and near-opaque ivory reading surface.",
      "Do keep Chinese question and note typography in Noto Serif SC.",
      "Do retain the horizontal navigation and narrow-screen tool tabs.",
      "Do label authored demo questions and lightweight scratchpaper accurately."
    ],
    "donts": [
      "Don't turn the workbook itself into a highly transparent glass panel.",
      "Don't replace the selected warm liquid-glass direction with the older pixel concepts.",
      "Don't expand the scratchpaper demo into a full notebook or handwriting-recognition product without a new request."
    ]
