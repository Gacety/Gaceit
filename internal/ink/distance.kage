package main

var P0, P1, P2 vec3
var A, B vec2
var KK, KX float
var Phase vec2
var Mode int
var Height float
var Zoom float
var Origin vec2
var Color vec4
var Mask int

// Analytic cubic stationary points of squared distance (IQ sdBezier, MIT).
func curve(pos vec2) vec2 {
 d := P0.xy-pos
 ky := KK*(2*dot(A,A)+dot(d,B))/3
 kz := KK*dot(d,A)
 p := ky-KX*KX
 q := KX*(2*KX*KX-3*ky)+kz
 h := q*q+4*p*p*p
 roots := vec3(0)
 count := 1
 if h >= 0 {
  x := (vec2(sqrt(h),-sqrt(h))-q)/2
  if abs(p)<0.001 && abs(q)>0.000000000001 {
   k:=p*p*p/q
   x=vec2(k,-k-q)
  }
  uv:=sign(x)*pow(abs(x),vec2(1.0/3.0))
  t:=uv.x+uv.y
  den:=3*(t*t+p)
  if abs(den)>0.000000000001 {t-=(t*(t*t+3*p)+q)/den}
  roots.x=t-KX
 } else {
  z:=sqrt(max(-p,0))
  v:=acos(clamp(q/(2*p*z),-1,1))/3
  m:=cos(v)
  n:=sin(v)*1.732050808
  roots=vec3(2*m,-n-m,n-m)*z-KX
  count=3
 }
 best:=1.0e30
 phase:=0.0
 for i:=0;i<3;i++ {
  if i<count {
   t:=clamp(roots[i],0,1)
   delta:=d+(2*A+B*t)*t
   ds:=dot(delta,delta)
   if ds<best {best=ds; phase=roots[i]}
  }
 }
 return vec2(sqrt(best),phase)
}
func Fragment(dst vec4,pos vec2) vec4 {
 p:=(dst.xy/pixelScale()-Origin)*(2/(Height*Zoom))-1
 d:=vec2(0)
 if Mode==2 {
  d=vec2(length(p-P0.xy),0)
  if P2.z>P0.z {d=vec2(length(p-P2.xy),1)}
 } else {
  if Mode==1 {
   chord:=P2.xy-P0.xy
   t:=dot(p-P0.xy,chord)/max(dot(chord,chord),0.000000000001)
   d=vec2(length(p-P0.xy-clamp(t,0,1)*chord),t)
  } else {d=curve(p)}
  d.y=clamp((d.y+Phase.x)/(1+Phase.x+Phase.y),0,1)
 }
 u:=1-d.y
 radius:=u*u*P0.z+2*u*d.y*P1.z+d.y*d.y*P2.z
 coverage:=clamp(0.5-(d.x-radius)*Height*Zoom*pixelScale()/2,0,1)
 if Mask==1 {
  // Opaque replacement preserves max coverage, including partial AA edges.
  return vec4(max(backdropAt(pos).r,coverage),0,0,1)
 }
 alpha:=Color.a*coverage
 return vec4(Color.rgb*alpha,alpha)
}
